      <aliases enabled='yes' />
      <column caption='%Total Hired' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_160440790463410176] / TOTAL([Calculation_160440790463410176])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Status' datatype='string' name='[Calculation_1219912602944921600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Termdate])THEN &apos;Hired&apos; ELSE &apos;Terminate&apos; END' />
      </column>
      <column caption='Highlight' datatype='boolean' name='[Calculation_1219912602951733249]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_160440790463410176]) = [Calculation_160440790463410176]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Top Rank' datatype='boolean' name='[Calculation_1219912603137486854]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK([Calculation1]) &lt;= 2'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Hired' datatype='integer' name='[Calculation_160440790463410176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee_ID])' />
      </column>
      <column caption='Total Terminated' datatype='integer' name='[Calculation_160440790465617921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if not ISNULL([Termdate]) THEN [Employee_ID] END )' />
      </column>
      <column caption='Total Active' datatype='integer' name='[Calculation_160440790467022850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='count(if isnull([Termdate]) THEN [Employee_ID] END)' />
      </column>
      <column caption='Location' datatype='string' name='[Calculation_836543684543754244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [State]&#13;&#10;    when&apos;New York&apos; then &quot;HQ&quot; else &quot;Brance&quot;&#13;&#10;end' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_836543684569268236]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[Birthdate],TODAY())' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_836543684570566669]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_836543684569268236] &lt; 25 THEN &apos;&lt;25&apos; &#13;&#10;ELSEIF   [Calculation_836543684569268236] &gt;= 25 AND [Calculation_836543684569268236]&lt;35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF   [Calculation_836543684569268236] &gt;= 35 AND [Calculation_836543684569268236]&lt;45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF   [Calculation_836543684569268236] &gt;= 45 AND [Calculation_836543684569268236]&lt;55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF   [Calculation_836543684569268236] &gt;= 55 THEN &apos;55+&apos;&#13;&#10;END' />
      </column>
